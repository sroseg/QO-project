# a function that calculates the time step of each node
def time_step(node_i,node_f):
    x_i= node_i[0]*dx
    x_f= node_f[0]*dx
    y_i= node_i[1]*dy - L_y/2
    y_f = node_f[1]*dy - L_y/2
    delta = (y_f - y_i) / (x_f - x_i) 
    S = Sfunc((x_i + x_f)/2, (y_i + y_f)/2)
    return ((x_f - x_i) * (1 + delta**2)) / (np.sqrt((1+ delta**2) * v**2 - S**2)- delta * S) 
  
  
# a function that calculates each route
def calculate_cost(route):
    total_cost = 0

    for i in range(len(route) - 1):
        total_cost += time_step(route[i], route[i + 1])

    total_cost += time_step((0,int((m+1)/2)), route[0]) #first step
    total_cost += time_step(route[-1], (n+1,int((m+1)/2)))     #last step

    return total_cost



