def forward_euler(PsiInit,t_f,dt):
    Psi = PsiInit
    
    t= 0
    while t < t_f:
        Psi = Psi  - Hpdiag*Psi*dt
        Psi = Psi/np.sqrt(sum(np.abs(Psi)**2))
