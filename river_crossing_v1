# This is a function to convert the index of the final state into a bitstream
def convert2ditstring(index, n, m):
    bitstr = np.zeros(n, dtype=int)
    number = index

    for i in range(n):
        check = number // m**(n-i-1)
        bitstr[i] = check
        number = number % m**(n-i-1)
    bitstr = bitstr + 1    
        
    return bitstr

